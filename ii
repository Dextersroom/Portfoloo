:root {
  color-scheme: dark;
  --bg: #070816;
  --surface: rgba(255, 255, 255, 0.08);
  --surface-strong: rgba(255, 255, 255, 0.14);
  --text: #f8fbff;
  --muted: #b9c3d9;
  --line: rgba(255, 255, 255, 0.18);
  --purple: #8b5cf6;
  --blue: #22d3ee;
  --coral: #fb7185;
  --lime: #a3e635;
  --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at 20% 10%, rgba(139, 92, 246, 0.28), transparent 32rem),
    radial-gradient(circle at 85% 20%, rgba(34, 211, 238, 0.2), transparent 28rem),
    linear-gradient(135deg, #070816 0%, #101126 54%, #171022 100%);
}

a { color: inherit; text-decoration: none; }
.container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
.section-pad { padding: 112px 0; }
.noise {
  position: fixed; inset: 0; pointer-events: none; opacity: 0.08; z-index: 1;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
.cursor-glow {
  position: fixed; left: 0; top: 0; width: 220px; height: 220px; border-radius: 999px;
  pointer-events: none; z-index: 20; transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(34,211,238,.26), rgba(139,92,246,.12) 45%, transparent 70%);
  filter: blur(10px); transition: width .25s ease, height .25s ease, opacity .25s ease;
}
.cursor-glow.is-active { width: 320px; height: 320px; opacity: .9; }

.site-header { position: sticky; top: 16px; z-index: 30; padding: 0 16px; }
.nav-shell {
  width: min(1120px, 100%); margin: 0 auto; padding: 12px 14px; display: flex; align-items: center; justify-content: space-between;
  border: 1px solid var(--line); border-radius: 999px; background: rgba(7, 8, 22, .62); backdrop-filter: blur(22px); box-shadow: var(--shadow);
}
.brand, .nav-links { display: flex; align-items: center; gap: 12px; }
.brand { font-weight: 900; letter-spacing: -.03em; }
.brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 14px; background: linear-gradient(135deg, var(--purple), var(--blue)); }
.nav-links a { padding: 10px 14px; color: var(--muted); font-weight: 700; transition: color .2s ease, transform .2s ease; }
.nav-links a:hover { color: var(--text); transform: translateY(-2px); }
.nav-cta { border-radius: 999px; background: linear-gradient(135deg, rgba(139,92,246,.9), rgba(34,211,238,.9)); color: white !important; }
.nav-toggle { display: none; border: 0; background: transparent; padding: 10px; }
.nav-toggle span { display: block; width: 24px; height: 2px; margin: 5px; background: white; }

.hero { position: relative; min-height: 88vh; display: grid; align-items: center; overflow: hidden; }
.mesh-bg { position: absolute; inset: 0; pointer-events: none; }
.blob { position: absolute; border-radius: 999px; filter: blur(22px); opacity: .72; animation: float 12s ease-in-out infinite alternate; }
.blob-one { width: 24rem; height: 24rem; left: 8%; top: 14%; background: var(--purple); }
.blob-two { width: 18rem; height: 18rem; right: 10%; top: 24%; background: var(--blue); animation-delay: -4s; }
.blob-three { width: 16rem; height: 16rem; left: 42%; bottom: 10%; background: var(--coral); animation-delay: -7s; }
.hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
.eyebrow { margin: 0 0 16px; color: var(--blue); font-weight: 900; text-transform: uppercase; letter-spacing: .16em; font-size: .78rem; }
h1, h2, h3 { margin: 0; line-height: .95; letter-spacing: -.06em; }
h1 { font-size: clamp(3.4rem, 9vw, 7.6rem); max-width: 820px; }
h2 { font-size: clamp(2.3rem, 5vw, 4.8rem); }
h3 { font-size: 1.65rem; }
.hero-subtitle, .contact-card p, .project-card p { color: var(--muted); font-size: 1.08rem; line-height: 1.75; }
.hero-subtitle { max-width: 650px; margin: 26px 0 34px; }
.hero-actions, .contact-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
.btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 22px; border-radius: 999px; font-weight: 900; transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
.btn-primary { background: linear-gradient(135deg, var(--coral), var(--purple), var(--blue)); box-shadow: 0 16px 48px rgba(139, 92, 246, .35); }
.btn-ghost { border: 1px solid var(--line); background: rgba(255,255,255,.06); }
.btn:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 22px 60px rgba(34, 211, 238, .28); }
.orbital-card, .contact-card, .project-card {
  border: 1px solid var(--line); background: linear-gradient(145deg, rgba(255,255,255,.14), rgba(255,255,255,.05)); backdrop-filter: blur(24px); box-shadow: var(--shadow);
}
.orbital-card { position: relative; overflow: hidden; padding: 34px; border-radius: 36px; min-height: 430px; display: flex; flex-direction: column; justify-content: end; }
.orbital-card::before { content: ""; position: absolute; inset: 34px; border-radius: 50%; border: 2px dashed rgba(255,255,255,.22); animation: spin 18s linear infinite; }
.orbital-card h2 { font-size: 7rem; background: linear-gradient(135deg, white, var(--blue)); -webkit-background-clip: text; color: transparent; }
.status-pill, .mini-metrics span { border: 1px solid var(--line); background: rgba(0,0,0,.18); border-radius: 999px; padding: 9px 12px; color: var(--muted); }
.status-pill { position: absolute; top: 24px; left: 24px; }
.status-pill span { display: inline-block; width: 9px; height: 9px; border-radius: 99px; background: var(--lime); margin-right: 8px; box-shadow: 0 0 18px var(--lime); }
.mini-metrics { display: flex; gap: 10px; flex-wrap: wrap; }

.section-heading { max-width: 780px; margin-bottom: 36px; }
.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
.project-card { position: relative; overflow: hidden; border-radius: 32px; min-height: 430px; transition: transform .32s ease, border-color .32s ease, box-shadow .32s ease; }
.project-card:hover { transform: translateY(-10px) rotateX(2deg); border-color: color-mix(in srgb, var(--accent) 70%, white); box-shadow: 0 28px 90px color-mix(in srgb, var(--accent) 32%, transparent); }
.project-preview { height: 220px; background: radial-gradient(circle at 25% 20%, var(--accent), transparent 28%), radial-gradient(circle at 75% 60%, var(--accent-2), transparent 30%), rgba(255,255,255,.06); }
.project-preview::after { content: ""; display: block; width: 72%; height: 58%; margin: 44px auto; border-radius: 24px; border: 1px solid rgba(255,255,255,.26); background: linear-gradient(135deg, rgba(255,255,255,.28), rgba(255,255,255,.06)); transform: rotate(-4deg); transition: transform .32s ease; }
.project-card:hover .project-preview::after { transform: rotate(2deg) scale(1.05); }
.project-content { padding: 26px; }
.tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
.tags span, .skill-cloud span { border: 1px solid var(--line); background: rgba(255,255,255,.08); border-radius: 999px; color: #dfe7ff; }
.tags span { padding: 7px 10px; font-size: .78rem; font-weight: 800; }
.skill-cloud { display: flex; flex-wrap: wrap; gap: 14px; }
.skill-cloud span { padding: 16px 20px; font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 900; transition: transform .25s ease, background .25s ease; animation: bob 4s ease-in-out infinite alternate; }
.skill-cloud span:nth-child(3n) { animation-delay: -1.5s; }
.skill-cloud span:hover { transform: translateY(-7px) scale(1.04); background: linear-gradient(135deg, rgba(139,92,246,.42), rgba(34,211,238,.32)); }
.contact-card { border-radius: 38px; padding: clamp(28px, 6vw, 64px); text-align: center; }
.contact-card p { max-width: 700px; margin: 22px auto 30px; }
.contact-actions { justify-content: center; }
.social { padding: 14px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-weight: 800; transition: color .2s ease, transform .2s ease; }
.social:hover { color: white; transform: translateY(-4px); }
.footer { display: flex; justify-content: space-between; gap: 16px; padding: 34px 0 54px; color: var(--muted); }
.reveal { opacity: 0; transform: translateY(28px) scale(.98); transition: opacity .7s ease, transform .7s ease; }
.reveal.is-visible { opacity: 1; transform: translateY(0) scale(1); }

@keyframes float { to { transform: translate3d(34px, -42px, 0) scale(1.08); } }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes bob { to { transform: translateY(-8px); } }

@media (max-width: 820px) {
  .section-pad { padding: 84px 0; }
  .hero-grid, .project-grid { grid-template-columns: 1fr; }
  .nav-toggle { display: block; }
  .nav-links { position: absolute; top: 74px; right: 16px; left: 16px; flex-direction: column; align-items: stretch; padding: 16px; border: 1px solid var(--line); border-radius: 24px; background: rgba(7,8,22,.92); backdrop-filter: blur(18px); transform: translateY(-12px); opacity: 0; pointer-events: none; transition: opacity .2s ease, transform .2s ease; }
  .nav-links.is-open { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .nav-links a { text-align: center; }
  .orbital-card { min-height: 340px; }
}
@media (max-width: 560px) {
  .container { width: min(100% - 22px, 1120px); }
  .hero { min-height: auto; padding-top: 66px; }
  h1 { font-size: 3.15rem; }
  .project-card { min-height: auto; }
  .footer { flex-direction: column; }
  .cursor-glow { display: none; }
}
